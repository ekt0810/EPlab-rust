# Use a new, dedicated database. Never point this version at the original EPlab database.
DATABASE_URL=postgresql://eplab:CHANGE_ME@127.0.0.1:5432/eplab_rust
APP_URL=http://127.0.0.1:3200
BIND_ADDR=127.0.0.1:3200
DATA_DIR=data
MAIL_MODE=local
# For HTTPS hosting set MAIL_MODE=smtp and configure SMTP; local mail is refused on public URLs.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Create at most two administrators via the admin command; passwords never have defaults.
# ADMIN_EMAIL=
# ADMIN_NAME=
# ADMIN_PASSWORD=
